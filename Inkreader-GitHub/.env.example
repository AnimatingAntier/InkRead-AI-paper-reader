# InkRead reads these optional environment variables at startup.
# Leave secrets empty in this file. Never commit a filled-in copy.

# Application storage and local server
INKREAD_DATA_DIR=
INKREAD_PORT=3217

# AI provider
OPENROUTER_API_KEY=

# Optional academic search
SERPAPI_API_KEY=

# Optional Baidu translation (local translation is used when omitted/unavailable)
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_API_KEY=

# Optional: exact previous settings file to import once
INKREAD_SEED_SETTINGS=

# Optional: comma-separated local origins for frontend development
INKREAD_DEV_ORIGIN=http://127.0.0.1:5178
